  "changes": [
    "Serialize lifecycle and preserve live thread stacks after failed joins",
    "Use nonblocking sockets with bounded control parsing and partial heartbeat writes",
    "Pause on sleep without unbounded wake wait",
    "Use returned system allocation address and retain exact ownership during cleanup",
    "Guard framebuffer copy with Draw lock and active-menu state; encode and send outside lock",
    "Validate JPEG source extent and row copy dimensions and memory spans",
    "Keep SOC shared references and NDM locking separate for streaming versus legacy users",
    "Keep upstream legal notices and remove nonlegal explanatory comments"
  ],
  "hardware_tested": false,
  "protocol": "NTR 84-byte TCP control on 8000; JPEG-over-UDP packets on 8001"
}
