diff --git a/sysmod/source/recorder_protocol.h b/sysmod/source/recorder_protocol.h
new file mode 100644
--- /dev/null
+++ b/sysmod/source/recorder_protocol.h
@@ -0,0 +1,37 @@
+#ifndef YU_RECORDER_PROTOCOL_H
+#define YU_RECORDER_PROTOCOL_H
+
+#define YU_REC_PORT "yu:rec"
+#define YU_REC_TITLE_ID 0x0004013000F1D302ULL
+#define YU_REC_CXI_PATH "/luma/sysmodules/0004013000F1D302.cxi"
+#define YU_REC_MAGIC 0x59555243u
+#define YU_REC_PROTOCOL_VERSION 1u
+#define YU_REC_STATUS_REQUEST 0x00010000u
+#define YU_REC_STATUS_REPLY 0x00010300u
+#define YU_REC_COMMAND_REQUEST 0x00020040u
+#define YU_REC_COMMAND_REPLY 0x00020040u
+#define YU_REC_ERROR_INVALID 0xD9001830u
+#define YU_REC_ERROR_BUSY 0xD043FBFAu
+#define YU_REC_ERROR_EXITING 0xD8A3FBF9u
+#define YU_REC_ERROR_STATE 0xD8A3FBF5u
+
+enum YuRecorderState {
+    YU_REC_STARTING,
+    YU_REC_IDLE,
+    YU_REC_RECORDING,
+    YU_REC_SAVING,
+    YU_REC_ERROR,
+    YU_REC_EXITED,
+    YU_REC_REPLAY
+};
+
+enum YuRecorderCommand {
+    YU_REC_CMD_NONE,
+    YU_REC_CMD_EXIT,
+    YU_REC_CMD_START,
+    YU_REC_CMD_STOP,
+    YU_REC_CMD_RELOAD,
+    YU_REC_CMD_SAVE_CLIP
+};
+
+#endif
