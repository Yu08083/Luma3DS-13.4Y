diff --git a/sysmod/source/capturegate.h b/sysmod/source/capturegate.h
new file mode 100644
--- /dev/null
+++ b/sysmod/source/capturegate.h
@@ -0,0 +1,39 @@
+#ifndef REC_CAPTUREGATE_H
+#define REC_CAPTUREGATE_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#define CAPTURE_GATE_CLOSED UINT32_C(0x80000000)
+
+static inline bool capture_gate_enter(uint32_t *gate)
+{
+    uint32_t value = __atomic_load_n(gate, __ATOMIC_RELAXED);
+    while (!(value & CAPTURE_GATE_CLOSED)) {
+        if (__atomic_compare_exchange_n(gate, &value, value + 1, true, __ATOMIC_ACQUIRE, __ATOMIC_RELAXED))
+            return true;
+    }
+    return false;
+}
+
+static inline void capture_gate_leave(uint32_t *gate)
+{
+    __atomic_fetch_sub(gate, 1u, __ATOMIC_ACQ_REL);
+}
+
+static inline void capture_gate_close(uint32_t *gate)
+{
+    __atomic_fetch_or(gate, CAPTURE_GATE_CLOSED, __ATOMIC_ACQ_REL);
+}
+
+static inline bool capture_gate_busy(const uint32_t *gate)
+{
+    return __atomic_load_n(gate, __ATOMIC_ACQUIRE) != CAPTURE_GATE_CLOSED;
+}
+
+static inline void capture_gate_open(uint32_t *gate)
+{
+    __atomic_store_n(gate, 0u, __ATOMIC_RELEASE);
+}
+
+#endif
